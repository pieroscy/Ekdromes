rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ο ιδιοκτήτης έχει πάντα πρόσβαση και μόνο αυτός διαχειρίζεται τη λίστα «Πρόσβαση».
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'pieriscy@gmail.com';
    }

    // Όσοι έχει προσθέσει ο ιδιοκτήτης από την οθόνη «Πρόσβαση».
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/access/$(request.auth.token.email.lower()));
    }

    function allowed() { return isOwner() || isMember(); }

    match /events/{id}    { allow read, write: if allowed(); }
    match /attendees/{id} { allow read, write: if allowed(); }
    match /expenses/{id}  { allow read, write: if allowed(); }

    // Λίστα πρόσβασης: όλη τη βλέπει/αλλάζει μόνο ο ιδιοκτήτης·
    // κάθε μέλος μπορεί να δει μόνο τη δική του εγγραφή (για να ξέρει η εφαρμογή ότι έχει πρόσβαση).
    match /access/{email} {
      allow read: if isOwner()
        || (request.auth != null && request.auth.token.email.lower() == email);
      allow create, update: if isOwner()
        && email == email.lower()
        && request.resource.data.email == email;
      allow delete: if isOwner();
    }
  }
}
